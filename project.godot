; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="1st Touhou Star ~ Broadest and Narrowest"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameEvents="*uid://crmumkxb3k5uc"
GameManager="*uid://ekf00dur5yyt"
BulletManager="*uid://r1cevfo2ay7l"
GameState="*uid://bd4sn2mxfar2u"
StageManager="*res://scripts/autoload/stage_manager.gd"
RNG="*res://scripts/autoload/rng.gd"
_MCPGameBridge="*uid://cds186n8uv4f0"
LaserManager="*res://scripts/autoload/laser_manager.gd"
MissEffectManager="*res://scripts/autoload/miss_effect_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=960
window/stretch/mode="viewport"
window/show_image=true
window/image=""

[editor_plugins]

enabled=PackedStringArray("res://addons/agent_tools/plugin.cfg")

