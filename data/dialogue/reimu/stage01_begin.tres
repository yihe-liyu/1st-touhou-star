[sub_resource type="Resource" id="Bubble_05"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("3_4o1qs")
emotion = "笑"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Bubble_06"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("4_qd2e5")
text = "快回家去吧。"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Line_04"]
