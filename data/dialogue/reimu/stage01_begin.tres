metadata/_custom_type_script = "uid://1k1h10sh5obn"

[sub_resource type="Resource" id="Bubble_21"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("3_4o1qs")
emotion = "疑惑"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Bubble_22"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("4_qd2e5")
text = "不，不行。
如果真见到了传说中的巫女，怎么能不打一场！"
emotion = "震惊"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Line_12"]
