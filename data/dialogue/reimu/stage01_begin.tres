[sub_resource type="Resource" id="Bubble_23"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("3_4o1qs")
emotion = "叹气"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Bubble_24"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("4_qd2e5")
text = "而且
在黑暗中，我可更胜一筹！"
emotion = "耍帅"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Line_13"]
