[sub_resource type="Resource" id="Bubble_07"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("3_4o1qs")
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Bubble_08"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("4_qd2e5")
text = "虽然我只是蝙蝠，但是再不走的话…"
emotion = "耍帅"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Line_05"]
