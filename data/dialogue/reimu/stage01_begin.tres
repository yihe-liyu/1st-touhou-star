[sub_resource type="Resource" id="Bubble_04"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("4_qd2e5")
text = "哦呀，弱小的人类怎么会在永夜出门？"
emotion = "疑惑"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Line_03"]
