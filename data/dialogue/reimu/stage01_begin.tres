[sub_resource type="Resource" id="Bubble_02"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("3_4o1qs")
text = "一般这时候就会有人出现了吧～"
emotion = "笑"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Line_02"]
