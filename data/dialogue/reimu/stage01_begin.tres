[sub_resource type="Resource" id="Bubble_13"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("3_4o1qs")
text = "我是巫女，我若是回家了，谁来解决异变呐，小小的蝙蝠哟？"
emotion = "叹气"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

