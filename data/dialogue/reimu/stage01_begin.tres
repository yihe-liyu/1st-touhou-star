[sub_resource type="Resource" id="Bubble_15"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("3_4o1qs")
emotion = "叹气"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Bubble_16"]
script = ExtResource("2_4o1qs")
speaker = ExtResource("4_qd2e5")
text = "啊，竟然遇到巫女了吗？"
emotion = "震惊"
metadata/_custom_type_script = "uid://ca60bikjhkwi1"

[sub_resource type="Resource" id="Line_09"]
script = ExtResource("1_y2afn")
